# Public site URL used for canonical links, Open Graph and the sitemap.
# Example: https://www.shaftai.co.za
NEXT_PUBLIC_SITE_URL=https://shaftai.example

# Formspree form id (the part after https://formspree.io/f/).
# Leave blank in development. The form validates, and a success state is shown,
# but nothing is emailed until this is set. In production, a missing id shows
# an error and asks the visitor to email you instead.
FORMSPREE_FORM_ID=
